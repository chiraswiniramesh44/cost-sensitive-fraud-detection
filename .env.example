# Copy to .env and fill in local/deployment values.
# Never commit a real .env file.

# PostgreSQL connection string used by SQLAlchemy
# Example: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# JWT signing configuration
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional: comma-separated browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# Path to model artifacts (local default; container uses /app/ml/models)
MODEL_DIR=./ml/models

# Used only by docker-compose for the local Postgres service
DOCKER_POSTGRES_PASSWORD=

# Optional direct Neon URL for admin/migration tooling
NEON_DIRECT_URL=

# Optional external AI tooling (not required by the fraud API runtime)
# GEMINI_API_KEY=
